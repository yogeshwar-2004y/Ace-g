{
  "name": "getaway-card-club",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node --import tsx server/index.ts",
    "build": "next build && esbuild server/index.ts --bundle --platform=node --packages=external --format=cjs --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "test:timers": "node --import tsx tests/timers.integration.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.11",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
